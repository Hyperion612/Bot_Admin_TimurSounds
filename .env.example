# --- Обязательно ---
BOT_TOKEN=123456789:AAA...токен от @BotFather
ADMIN_ID=1234567890
# Канал: числовой ID бота-админа (например -1001234567890) или @username
CHANNEL_ID=-1001234567890

# --- Деплой (Render/Tranger Cloud) ---
# true — webhook (рекомендуется для PaaS), false — long polling
WEBHOOK_MODE=false
# Публичный URL сервиса, например https://releasebot.onrender.com
PUBLIC_URL=
# Секрет для проверки вебхуков (сгенерируйте случайную строку)
WEBHOOK_SECRET=
# PORT задаёт сам хостинг (Render использует 10000 по умолчанию)
PORT=10000
DB_NAME=releases.db
